# Copy to .env and adjust. The API reads this file from the repo root.

# ---- deployment -------------------------------------------------------------
# dev | staging | prod. Outside dev the API refuses to start without real
# credentials — see the auth section below.
ENV=dev
DOMAIN=example.com
LOG_LEVEL=INFO

# ---- storage ----------------------------------------------------------------
# Relative paths resolve against the repo root. docker-compose overrides this
# to /data/cctv.db, which is the mounted ./data volume.
DATABASE_PATH=data/cctv.db
EVENT_RETENTION_DAYS=30

# ---- web ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. '*' is rejected
# outside dev.
CORS_ORIGINS=http://localhost:5173

# ---- auth --------------------------------------------------------------------
# Signs the bearer tokens the web UI uses. Must be at least 32 characters and
# must not be the placeholder below when ENV is not dev.
#   generate with:  openssl rand -hex 32
JWT_SECRET=change-me

# Machine credentials for the NVR and ML worker, comma separated:
#   API_KEYS=name:secret:scope|scope
# Scopes are 'read' and 'write'. Example:
#   API_KEYS=nvr-ingest:sk_live_xxx:write,dashboard:sk_ro_yyy:read
API_KEYS=

# Dev escape hatch: skip auth entirely. Ignored unless ENV=dev.
AUTH_DISABLED=false
